{
  "name": "budget-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Personal Budget Manager for Ramesh Nerella (React + Express + SQLite)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "start": "npm run start -w server",
    "build": "npm run build -w client",
    "migrate": "npm run migrate -w server",
    "seed": "npm run seed -w server",
    "seed:reset": "npm run seed:reset -w server",
    "test": "npm run test -w server",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,jsx,scss,json,md}\""
  },
  "overrides": {
    "shell-quote": "^1.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.0"
  }
}
