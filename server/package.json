{
  "name": "budget-manager-server",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for the Personal Budget Manager (Express + SQLite)",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/database/scripts/migrate.js",
    "seed": "node src/database/scripts/seed.js",
    "seed:reset": "node src/database/scripts/seed.js --reset",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0"
  }
}
