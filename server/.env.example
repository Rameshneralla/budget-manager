# Copy this file to server/.env and adjust values as needed.

# Port the API listens on
PORT=5000

# SQLite database file (relative paths are resolved from the project root: budget-manager/)
DATABASE_PATH=./database/budget.sqlite

# Folder where "Backup Database" writes timestamped copies
BACKUP_DIR=./database/backups

# Comma-separated list of browser origins allowed to call the API (Vite dev server by default)
CORS_ORIGIN=http://localhost:5173

# Seed the October 2026 data automatically when the database has no data yet (true/false)
SEED_ON_EMPTY=true

# development | production | test
NODE_ENV=development

# ----------------------------------------------------------------------------
# Login
# ----------------------------------------------------------------------------
# Password for signing in. REQUIRED when NODE_ENV=production (the server will not
# start without it). Leave empty only for local use on your own computer.
APP_PASSWORD=

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# How long a sign-in lasts, in hours
SESSION_MAX_AGE_HOURS=12
